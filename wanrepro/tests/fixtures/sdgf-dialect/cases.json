  "purpose": "SDGF 方言的**唯一共享夹具**：TS（web/scripts/probe-sdgf-payload.mjs）与 PY（wanrepro/automation/probe_sdgf_dialect.py）加载同一份输入+期望，单改任一端实现 → 至少一条 case 必红。",
  "schema": {
    "input": {
      "model": "画布传给渠道的裸模型名（原样，不 trim 由实现做）",
      "ratio": "最终 aspect_ratio 值（= bridge payload.ratio = 渠道请求体 aspect_ratio；16:9|9:16|1:1|4:3|3:4|adaptive|21:9）",
      "size": "可选：画布侧 size 输入（只有 auto 这类需归一的值才填；缺省时 TS 侧按 ratio 本身过映射）",
      "sound": "布尔：面板「生成音频」",
      "duration": "整数秒（请求值，未截断）",
      "mode": "frames | reference（画布 videoMode）",
      "imageCount": "参考图张数"
    },
    "expect": {
      "fullModel": "满血 GF 精确名判定（纯函数）",
      "ratioFields": "纯函数比例字段（键序不比，值全等）",
      "soundFields": "纯函数声音字段（sendParam 恒 true——总开关不进夹具，映射范围在此显式锁定）",
      "clampDuration": "纯函数时长（代际截断后）",
      "modeName": "站方中文 mode；null = 该输入被拒、无 mode 名",
      "assembly": {
        "ok": "组装/预检是否通过",
        "reject": "ok=false 时的拒绝因：model | duration | ratio | reference-no-image"
      },
      "metadata": "组装体 metadata 合并结果（ratio 与 sound 的 metadata 同一对象；null = 不带 metadata 键）；仅 ok=true 时断言",
      "topEnableSound": "组装体顶层 enableSound（null = 无该键）；仅 ok=true 时断言"
    }
  },
